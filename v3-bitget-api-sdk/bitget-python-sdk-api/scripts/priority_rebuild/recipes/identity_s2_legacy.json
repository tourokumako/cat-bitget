{
  "_note": "恒等検収レシピ＝現行 S2（e38_logic_parts.generic_logic_loop・confirm=stoch_dc 構成）の書き写し。正本＝engine_tuner_step2_condition_format.md §8（S2 との1対1突き合わせ表）。lane=legacy＝生値 legacy と legacy 材料列を使える唯一のレーン（探索は生成できない・番人で隔離）。値は恒等の照合用に選んだ legacy（採否・成績とは無関係＝両側が同じ値を共有して md5 を比べるためだけの値）。",
  "_taiou": "設計書 §8 の行番号: 行1-2=meta.regime と band_ok（実行器が課す）／行3=location 条件／行4=env 条件／行5=sufficiency 条件／行6=trigger（cross）／行7=実行器のグローバル定数（H5）／行8=TP1 枝／行9=TP2 枝／行10=SL 枝／行11=TIME 枝（be_wait）／行12=exits の並び順／行13=position。行6 の材料の実体＝stoch_k は Stoch%D14__5m と同式（e34_range_base の slow %K(14,3)）・その3本平均はカタログ外＝legacy 材料列（設計書 §8 は Stoch%K14/D14 と書いたが実装の実体はこの2列＝worklog 2026-08-01 に記録）。",
  "meta": { "strategy": "e38", "logic_id": "S2ID", "side": "SHORT",
            "regime": { "name": "range", "entry_col": "range_ok_rg5", "block_col": "rg5_uptrend" },
            "lane": "legacy" },
  "pre_filter": [],
  "entry": {
    "connective": { "all": [
      { "role": "trigger", "form": "cross", "value": { "direction": "down" },
        "material": [
          { "legacy_col": "stoch_k", "family": "Stoch%D", "imi": "Stoch%D14__5m と同式（e34_range_base slow %K(14,3)）" },
          { "legacy_col": "e38_stoch_d", "family": "Stoch%D", "imi": "stoch_k の3本平均＝Stoch(14,3,3) の %D・カタログ外＝legacy 材料" }
        ] },
      { "role": "env", "form": "level", "side": "below", "value": { "legacy": 0.8 },
        "material": [ { "family": "ROC", "param": 24, "tf": "2h" } ] },
      { "role": "sufficiency", "form": "level", "side": "above", "value": { "legacy": 0.9 },
        "material": [ { "family": "volume_ratio", "param": 20, "tf": "15m" } ] },
      { "role": "location", "form": "level", "side": "above", "value": { "legacy": 0.55 },
        "material": [ { "geo": "帯内位置%" } ] }
    ] }
  },
  "entry_guards": {
    "tp_inside": "TP2",
    "fee_floor_vs": "TP1",
    "fee_floor": { "const": "SCALP_FLOOR" },
    "require_finite": [ "SL" ]
  },
  "exits": [
    { "name": "TIME", "reason": "TIME_EXIT",
      "fire": { "all": [ { "role": "env", "form": "level", "side": "above", "value": { "n": 30 },
                          "material": [ { "state": "hold_min" } ] } ] },
      "exec": { "method": "taker", "placement": { "kind": "on_close" },
                "be_wait": { "level": { "kind": "pct", "base": "avg",
                                         "k": { "const": "SCALP_FLOOR", "side_sign": "profit" } },
                             "ttl": { "const": "BE_TTL_BARS" } } },
      "size_ratio": 1.0 },
    { "name": "SL", "reason": "SL_FILLED",
      "exec": { "method": "maker", "placement": { "kind": "resting", "fill": "adverse", "pessimistic": true,
                                                   "level": { "kind": "zone_sl", "k": { "legacy": 1.0 } } } },
      "size_ratio": 1.0 },
    { "name": "TP1", "reason": "PARTIAL_TP", "once": true,
      "exec": { "method": "maker", "placement": { "kind": "resting", "fill": "profit",
                                                   "level": { "kind": "mix", "from": "entry", "to": "TP2",
                                                              "frac": { "legacy": 0.5 } } } },
      "size_ratio": 0.5 },
    { "name": "TP2", "reason": "TP_FILLED",
      "exec": { "method": "maker", "placement": { "kind": "resting", "fill": "profit",
                                                   "level": { "kind": "zone", "target": "mid" } } },
      "size_ratio": 1.0 }
  ],
  "position": { "mode": "separate", "max_adds": 2 }
}
